# ---- Claude (optional) -----------------------------------------------------
# Only needed if you want the app to build proposals by itself (Scan button / weekly schedule).
# Without it, run the analysis from a Claude Code session: npm run packet -> reason -> npm run propose.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ---- App --------------------------------------------------------------------
PORT=8788
DISPLAY_TZ=America/Chicago

# ---- Notifications (optional) ----------------------------------------------
# Install the ntfy app (ntfy.sh), subscribe to a topic name nobody can guess, put it here.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
