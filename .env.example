# ---- Claude (optional) -----------------------------------------------------
# Only needed if you want the app to build proposals by itself (Scan button / weekly schedule).
# Without it, run the analysis from a Claude Code session: npm run packet -> reason -> npm run propose.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ---- App --------------------------------------------------------------------
PORT=8788
WEB_PORT=5174
DISPLAY_TZ=America/Chicago

# ---- Phone ------------------------------------------------------------------
# The address your phone opens (also the tap-through link on pushes). Leave blank to auto-detect
# the machine's Tailscale IP (http://100.x.y.z:5174) when the Tailscale CLI is installed.
DASHBOARD_URL=

# ---- Notifications ----------------------------------------------------------
# Install the ntfy app (ntfy.sh) on your phone, subscribe to exactly this topic. Treat it like a password.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---- Public page --------------------------------------------------------------
# GitHub Pages URL of the read-only weekly page (docs/ on main). Blank = no friends pushes.
PAGES_URL=
# Picks-only topic for friends following along (they subscribe in the ntfy app).
NTFY_FRIENDS_TOPIC=
